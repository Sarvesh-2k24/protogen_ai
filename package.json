{
  "name": "protocol_gen",
  "version": "1.0.0",
  "description": "ICH M11 Clinical Trial Protocol Generator with Meta-Llama-3.1-8B-Instruct AI",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "llm": "python server/llm_server.py",
    "client": "cd client && npm run dev",
    "dev": "concurrently -n \"LLM,API,UI\" -c \"magenta,blue,green\" \"python server/llm_server.py\" \"node server/index.js\" \"cd client && npm run dev\"",
    "start": "concurrently -n \"LLM,API\" -c \"magenta,blue\" \"python server/llm_server.py\" \"node server/index.js\"",
    "build": "cd client && npm run build"
  },
  "keywords": [
    "clinical-trial",
    "ich-m11",
    "spirit",
    "protocol-generator",
    "llama-3.1",
    "huggingface",
    "chatbot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "docx": "^9.6.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1"
  }
}
